# Copy to .env.local and adjust. Never put secrets in VITE_* variables:
# they are bundled into the browser code.

# WalkLah FastAPI backend (must run on this address; see backend/HANDOFF.md)
VITE_API_BASE_URL=http://127.0.0.1:8000

# MapLibre style JSON. OpenFreeMap is keyless and OSM-based.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Shows the "Use rehearsed demo spot" shortcut in the report form.
VITE_DEMO_MODE=true
